# Copy to .env (read automatically) or export as environment variables.

# Model -----------------------------------------------------------------
DETECT_BACKEND=ultralytics          # ultralytics | onnxruntime | package.module:Class
DETECT_MODEL_WEIGHTS=yolo12n.pt     # .pt name/path, or a .onnx file for onnxruntime
# DETECT_MODEL_ARCH=                # yolo (default) | rtdetr
# DETECT_MODEL_LABELS=              # label file overriding the names in the weights
# DETECT_MODEL_VERSION=             # tag echoed in every response
# DETECT_DEVICE=                    # cpu | cuda | cuda:0 | mps (auto when empty)
# DETECT_THREADS=                   # CPU threads per inference (all host cores when empty)
# DETECT_ONNX_PROVIDERS=            # onnxruntime: e.g. CUDAExecutionProvider,CPUExecutionProvider

# Detection -------------------------------------------------------------
DETECT_TARGET_CLASSES=cat           # comma separated, "*" for all classes
DETECT_CONFIDENCE_THRESHOLD=0.25
DETECT_IOU_THRESHOLD=0.45
DETECT_IMAGE_SIZE=640               # onnxruntime: only applies to --dynamic exports
DETECT_MAX_DETECTIONS=100

# Limits ----------------------------------------------------------------
DETECT_MAX_UPLOAD_BYTES=10485760
DETECT_MAX_IMAGE_PIXELS=40000000
